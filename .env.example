# Copy this file to .env and fill it in. Never commit .env.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
