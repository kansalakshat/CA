# Copy this file to .env and fill it in. Never commit .env.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Supabase > Connect > Connection String > "Transaction pooler" (port 6543), with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Email (for sign-up confirmation links). Any SMTP service works. Example: Gmail with an App Password
# (Google Account > Security > 2-Step Verification > App passwords). Leave SMTP_HOST empty locally to print emails in the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=CA Firm CRM <you@gmail.com>

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URIs: https://ca-0s.vercel.app/api/auth/google/callback  and  http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the site, used in email links and for Google. On Vercel it is detected automatically.
# APP_URL=https://ca-0s.vercel.app
